{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "app" } }],
  "regions": ["sin1"],
  "crons": [{ "path": "/api/internal/cron/employees-sync", "schedule": "0 19 * * *" }]
}
