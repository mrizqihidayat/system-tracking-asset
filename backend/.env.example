APP_NAME="Asset Tracking SHD"
# Nilai di file ini aman untuk production.
# Untuk dev lokal ganti: APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Log keamanan (login, hapus aset) di storage/logs/security-*.log: berapa hari disimpan
LOG_SECURITY_DAYS=90

# PostgreSQL Supabase (Session pooler, port 5432)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin frontend yang diizinkan CORS (pisahkan koma jika lebih dari satu; yang pertama = URL utama)
FRONTEND_URL=http://localhost:5173
# URL dasar isi QR label: {QR_BASE_URL}/scan/{kode aset}. Kosongkan untuk default = FRONTEND_URL (origin pertama)
QR_BASE_URL=

# IP/CIDR reverse proxy yang dipercaya, pisahkan koma (mis. 10.0.0.1,10.0.1.0/24). Kosong untuk lokal tanpa proxy.
# Wajib diisi jika ada proxy: tanpa ini semua pengunjung terbaca satu IP dan berbagi rate limit.
# "*", REMOTE_ADDR, dan 0.0.0.0/0 sengaja diabaikan karena mempercayai semua pengirim.
TRUSTED_PROXIES=

# Masa berlaku token login (menit)
SANCTUM_EXPIRATION=480

# Disk default framework & disk foto/dokumen aset: local (dev) atau s3 (deploy)
FILESYSTEM_DISK=local
ASSET_DISK=local

# Wajib jika ASSET_DISK=s3. Contoh Supabase Storage (S3-compatible):
#   AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   AWS_DEFAULT_REGION=<region project>
#   AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
