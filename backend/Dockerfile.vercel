# Image container untuk Vercel (T38). FrankenPHP (Caddy + PHP 8.3), mengikuti panduan Vercel "Deploy Laravel on Vercel with Docker".
# Build lokal:  docker build -f Dockerfile.vercel -t asset-backend .
# Env (APP_KEY, DB_*, dll.) TIDAK dimasukkan ke image dan config TIDAK di-cache saat build: semua dibaca saat runtime.

FROM dunglas/frankenphp:1-php8.3-bookworm AS base

# gd untuk QR (chillerlan) dan PDF label (dompdf); zip + xmlwriter untuk Excel (openspout); pdo_pgsql untuk Supabase.
# mbstring dan dom sudah bawaan image, tetap disebut agar eksplisit.
RUN install-php-extensions gd zip pdo_pgsql mbstring dom xmlwriter \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Gagalkan build bila ada ekstensi wajib yang tidak terpasang.
RUN for ext in gd zip pdo_pgsql mbstring dom xmlwriter; do \
        php -m | grep -qix "$ext" || { echo "Ekstensi PHP hilang: $ext"; exit 1; }; \
    done

COPY docker/php.ini "$PHP_INI_DIR/conf.d/zz-app.ini"

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --optimize-autoloader --prefer-dist

COPY . .
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan package:discover --ansi

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Bawaan runtime; dapat ditimpa env Vercel. Disk container tidak permanen: log ke stderr, upload ke S3/Supabase Storage,
# cache di database (throttle login dan kunci sinkronisasi tetap global), tanpa session (API Bearer token).
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    LOG_SECURITY_STDERR=true \
    CACHE_STORE=database \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync \
    ASSET_DISK=s3

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
