// ERD Sistem Informasi Aset SHD — tempel di https://dbdiagram.io

Enum asset_condition {
  Baik
  "Rusak Ringan"
  "Rusak Berat"
}

Enum asset_status {
  Tersedia
  Dipinjam
  Perbaikan
  Hilang
  "Tidak Layak Pakai"
}

Enum event_type {
  Registrasi
  Dipinjam
  Dikembalikan
  Dibatalkan
  "Pindah Lokasi"
  "Lapor Rusak"
  "Lapor Hilang"
  Servis
  "Ubah Data"
  Ditemukan
  "Tidak Layak Pakai"
}

Enum loan_status {
  Direncanakan [note: 'pemesanan: tanggal pinjam di masa depan, aset tetap Tersedia (T31)']
  Dipinjam
  Dikembalikan
  Dibatalkan
  Hilang [note: 'hilang saat dipinjam']
}

Enum damage_confirmation {
  "Menunggu Konfirmasi"
  Dikonfirmasi
}

Enum count_method {
  QR
  Manual
}

Enum request_status {
  Diajukan
  Diterima
  Dikembalikan
  Dibatalkan
}

Enum file_type {
  "Foto Aset"
  "Foto Kondisi"
  BAST
  Garansi
  Lainnya
}

Table users {
  id bigint [pk, increment]
  nik varchar(30) [unique, note: 'akun pegawai SHD (source api), login NIK (T33)']
  name varchar(100) [not null, note: 'akun api: disinkronkan dari direktori pegawai setiap login']
  username varchar(50) [unique, note: 'akun bersama (source manual), login username']
  department varchar(100) [note: 'akun api: dari direktori (departemen/divisi/grup); akun manual: nama dari master departments']
  source varchar(10) [not null, default: 'manual', note: 'api | manual (CHECK); api wajib nik, manual wajib username (CHECK)']
  password varchar(255) [not null, note: 'akun api sebelum ganti password: hash acak, login memakai NIK sebagai password (T33 R1)']
  must_change_password boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [note: 'nonaktif (soft delete), bisa diaktifkan kembali']
}

Table departments {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  is_internal boolean [not null, default: false, note: 'true = SHD']
  created_at timestamp
  updated_at timestamp
}

Table buildings {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  slug varchar(120) [not null, unique, note: 'URL frontend, otomatis dari nama, ikut berubah saat nama diganti']
  created_at timestamp
  updated_at timestamp
}

Table rooms {
  id bigint [pk, increment]
  building_id bigint [not null, ref: > buildings.id]
  name varchar(100) [not null]
  slug varchar(120) [not null, note: 'URL frontend, unik per gedung, ikut berubah saat nama diganti']
  is_storage boolean [not null, default: false, note: 'gudang / tempat penyimpanan: boleh menjadi lokasi simpan stok, tidak masuk hitungan kesiapan']
  last_checked_at timestamp
  last_checked_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (building_id, name) [unique]
    (building_id, slug) [unique]
  }
}

Table consumable_categories {
  id bigint [pk, increment]
  name varchar(100) [not null, note: 'unik tanpa beda huruf besar/kecil: unique index lower(name)']
  created_at timestamp
  updated_at timestamp

  Note: 'Kategori stok habis pakai'
}

Table categories {
  id bigint [pk, increment]
  name varchar(100) [not null, unique, note: 'Elektronik, Furnitur, Alat Pelatihan, ...']
  created_at timestamp
  updated_at timestamp

  Note: 'Kategori aset (tingkat atas jenis aset); hapus ditolak bila masih dipakai jenis'
}

Table asset_types {
  id bigint [pk, increment]
  category_id bigint [not null, ref: > categories.id, note: 'wajib; restrict on delete']
  name varchar(100) [not null, unique, note: 'Proyektor, Laptop, ...']
  code varchar(5) [not null, unique, note: 'PRJ, LPT (otomatis, bisa diedit; tidak boleh kode bekas jenis lain)']
  last_number int [not null, default: 0, note: 'penghitung nomor urut kode aset, tidak pernah turun']
  created_at timestamp
  updated_at timestamp
}

Table assets {
  id bigint [pk, increment]
  code varchar(20) [not null, unique, note: 'SHD-PRJ-001']
  public_token varchar(32) [not null, unique, note: 'acak 12 karakter, link QR /aset/{token}, tidak berubah']
  asset_type_id bigint [not null, ref: > asset_types.id]
  name varchar(255) [not null]
  brand varchar(100)
  serial_number varchar(100)
  specification text
  source_department_id bigint [not null, ref: > departments.id]
  room_id bigint [not null, ref: > rooms.id, note: 'lokasi asal/seharusnya']
  pic_name varchar(150) [note: 'penanggung jawab']
  finance_code varchar(100) [note: 'kode aset keuangan']
  acquisition_date date
  next_service_date date
  condition asset_condition [not null, default: 'Baik']
  status asset_status [not null, default: 'Tersedia']
  note text
  created_by bigint [not null, ref: > users.id]
  created_at timestamp
  updated_at timestamp

  Note: 'Tanpa soft delete: Hapus aset = hard delete lewat AssetService (data turunan dihapus dulu)'
}

Table asset_code_histories {
  id bigint [pk, increment]
  asset_id bigint [not null, ref: > assets.id]
  asset_type_id bigint [not null, ref: > asset_types.id, note: 'jenis aset saat kode ini dipakai']
  code varchar(20) [not null, unique, note: 'kode lama, tetap bisa dicari']
  replaced_at timestamp [not null]
  replaced_by bigint [not null, ref: > users.id]

  Note: 'Kode lama aset saat jenis diganti; mencegah kode jenis bekas dipakai jenis lain'
}

Table asset_files {
  id bigint [pk, increment]
  asset_id bigint [not null, ref: > assets.id]
  file_type file_type [not null]
  path varchar(500) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(100)
  size int
  uploaded_by bigint [not null, ref: > users.id]
  created_at timestamp
}

Table asset_events {
  id bigint [pk, increment]
  asset_id bigint [not null, ref: > assets.id]
  event_type event_type [not null]
  event_date timestamp [not null]
  party varchar(150) [note: 'peminjam / vendor / SHD']
  condition asset_condition
  from_room_id bigint [ref: > rooms.id]
  to_room_id bigint [ref: > rooms.id]
  loan_id bigint [ref: > loans.id]
  recorded_by bigint [not null, ref: > users.id]
  note text
  created_at timestamp
}

Table loans {
  id bigint [pk, increment]
  asset_id bigint [not null, ref: > assets.id]
  borrower_name varchar(150) [not null]
  borrower_unit varchar(100) [not null]
  purpose varchar(255) [not null, note: 'keperluan/kegiatan']
  destination_room_id bigint [ref: > rooms.id]
  destination_note varchar(255) [note: 'lokasi tujuan di luar daftar ruangan']
  borrow_date date [not null, note: 'tanggal pinjam; untuk pemesanan = tanggal rencana (tidak berubah saat Serahkan)']
  handover_date date [note: 'tanggal penyerahan sebenarnya saat Serahkan pemesanan (T31)']
  due_date date [not null]
  condition_out asset_condition [not null, note: 'otomatis dari kondisi aset saat dipinjam / diserahkan']
  approval_number varchar(100) [note: 'no. / tanggal approval, satu kolom teks bebas di form']
  approval_date date [note: 'data lama & API; form tidak lagi mengisi']
  borrowed_by bigint [not null, ref: > users.id, note: 'staf pencatat']
  status loan_status [not null, default: 'Dipinjam']
  return_date timestamp
  return_condition asset_condition
  return_room_id bigint [ref: > rooms.id]
  received_by bigint [ref: > users.id]
  damage_confirmation damage_confirmation [note: 'data lama, alur konfirmasi dihapus (T26j)']
  damage_confirmed_at timestamp
  damage_confirmed_by bigint [ref: > users.id]
  damage_confirmation_note text [note: 'wajib saat konfirmasi']
  damage_confirmation_document varchar(100) [note: 'no. berita acara/memo (opsional)']
  cancel_reason text
  note text
  created_at timestamp
  updated_at timestamp

  Note: 'Maksimal satu loan berstatus Dipinjam per aset (partial unique index). Periode Direncanakan/Dipinjam per aset tidak boleh tumpang tindih (dicek di LoanService di bawah lock aset).'
}

Table request_catalog {
  id bigint [pk, increment]
  item_name varchar(150) [not null]
  provider_department_id bigint [not null, ref: > departments.id]
  must_return boolean [not null, default: false]
  lead_time_days int [not null, default: 0]
  note text
  created_at timestamp
  updated_at timestamp
}

Table supply_requests {
  id bigint [pk, increment]
  request_date date [not null]
  catalog_id bigint [ref: > request_catalog.id, note: 'ON DELETE SET NULL (katalog boleh dihapus)']
  consumable_id bigint [ref: > consumables.id, note: 'barang stok yang diminta; ON DELETE SET NULL']
  item_name varchar(150) [not null, note: 'nama barang jika tertaut stok']
  quantity int [not null, note: '> 0']
  purpose varchar(255) [note: 'untuk kegiatan']
  room_id bigint [ref: > rooms.id]
  provider_department_id bigint [not null, ref: > departments.id]
  request_method varchar(50) [note: 'cara permintaan per permintaan; teks bebas, saran Memo | Form | Email | WhatsApp | Lainnya; wajib di API, null untuk data lama']
  lead_time_days int [note: 'snapshot dari katalog saat dibuat/diubah (Diajukan); null tanpa katalog']
  must_return boolean [not null, default: false, note: 'pilihan di form: Dikembalikan / Tidak dikembalikan; default dari katalog']
  status request_status [not null, default: 'Diajukan']
  received_quantity int [not null, default: 0, note: 'jumlah yang sudah masuk stok; Diterima sebagian jika kurang dari quantity']
  received_at timestamp
  returned_at timestamp
  note text
  created_by bigint [not null, ref: > users.id]
  created_at timestamp
  updated_at timestamp

  Note: '"Belum direspons" = Diajukan yang melewati snapshot lead_time_days (dihitung)'
}

Table stock_transactions {
  id bigint [pk, increment]
  consumable_id bigint [not null, ref: > consumables.id, note: 'ON DELETE CASCADE (hanya saldo awal yang bisa ikut terhapus)']
  type varchar [not null, note: 'Barang Masuk | Pemakaian | Koreksi | Penghapusan']
  quantity int [not null, note: 'bertanda, tidak 0']
  balance_after int [not null, note: 'stok setelah transaksi, >= 0']
  transaction_date date [not null]
  reason varchar(20) [note: 'Penghapusan: rusak | kedaluwarsa | lainnya']
  note text [note: 'keterangan; wajib untuk Koreksi']
  is_opening boolean [not null, default: false, note: 'saldo awal']
  room_id bigint [ref: > rooms.id, note: 'tujuan Pemakaian']
  supply_request_id bigint [ref: > supply_requests.id, note: 'Barang Masuk / Koreksi dari permintaan; ON DELETE SET NULL']
  created_by bigint [ref: > users.id, note: 'staf pencatat; kosong untuk saldo awal hasil migrasi']
  created_at timestamp
  updated_at timestamp
}

Table room_standards {
  id bigint [pk, increment]
  room_id bigint [not null, ref: > rooms.id]
  standard_quantity int [not null, note: '> 0; jenis aset tanpa baris berarti standar 0']
  count_method count_method [not null]
  asset_type_id bigint [ref: > asset_types.id, note: 'wajib jika QR; unik per ruangan']
  actual_quantity int [note: 'Manual: saldo transaksi ruangan + barang (= balance_after terakhir, 0 tanpa transaksi), diubah hanya lewat RoomStockService; null hanya untuk baris QR']
  checked_at timestamp [note: 'Manual: waktu cek terakhir; null = Belum dicek (bukan kurang). Barang yang ditambahkan ke ruangan selalu null']
  consumable_id bigint [ref: > consumables.id, note: 'wajib jika Manual; unik per ruangan; ON DELETE CASCADE']
  created_at timestamp
  updated_at timestamp

  Note: 'QR = standar per jenis aset. Manual = barang dari Stok. Nama mengikuti jenis/barangnya'
}

Table room_stock_transactions {
  id bigint [pk, increment]
  room_id bigint [not null, ref: > rooms.id, note: 'ruangan bukan gudang; hapus ruangan ditolak bila punya riwayat']
  consumable_id bigint [not null, ref: > consumables.id, note: 'ON DELETE CASCADE (barang hanya bisa dihapus permanen saat salah input)']
  type varchar(20) [not null, note: 'Saldo awal | Diisi | Terpakai | Hilang | Rusak | Kedaluwarsa | Koreksi']
  quantity int [not null, note: 'bertanda, tidak 0']
  balance_after int [not null, note: 'jumlah Ada setelah transaksi, >= 0']
  transaction_date date [not null]
  note text [note: 'wajib untuk Koreksi; boleh kosong untuk jenis lain']
  stock_transaction_id bigint [ref: > stock_transactions.id, note: 'Diisi dari Isi dari stok; ON DELETE SET NULL']
  created_by bigint [ref: > users.id, note: 'staf pencatat; kosong untuk Saldo awal hasil migrasi']
  created_at timestamp
  updated_at timestamp

  indexes {
    (room_id, consumable_id, id)
  }

  Note: 'Kartu ruangan (T30). Dikunci per ruangan + barang, bukan baris standar: riwayat tetap saat barang dilepas. Hanya ditulis lewat RoomStockService::record()'
}

Table consumables {
  id bigint [pk, increment]
  name varchar(150) [not null, note: 'unik tanpa beda huruf besar/kecil: unique index lower(name)']
  consumable_category_id bigint [ref: > consumable_categories.id, note: 'opsional; hapus kategori ditolak bila masih dipakai']
  unit varchar(20) [not null]
  quantity int [not null, default: 0]
  min_quantity int [not null, default: 0]
  provider_department_id bigint [not null, ref: > departments.id, note: 'minta ke (isi ulang); menjadi sumber baris standar yang memakainya']
  room_id bigint [ref: > rooms.id, note: 'lokasi simpan, wajib lewat API dan harus ruangan is_storage; kosong hanya untuk data lama yang tidak cocok saat migrasi; hapus ruangan ditolak bila masih dipakai; tidak dihitung sebagai Ada di ruangan']
  note text
  created_at timestamp
  updated_at timestamp

  Note: 'Semua barang habis pakai, tidak tertaut katalog. quantity = hasil stock_transactions. Hapus permanen hanya jika transaksinya saldo awal saja'
}
