ometry"/></mxCell><mxCell id="p11-E" value="Ada pegawai valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="761" width="210" height="90" as="geometry"/></mxCell><mxCell id="p11-G" value="Catat run dibatalkan; tidak ada yang dinonaktifkan" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="930" width="250" height="68" as="geometry"/></mxCell><mxCell id="p11-H" value="Satu transaksi: upsert pegawai per nik, aktifkan kembali yang muncul lagi" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="921" width="250" height="85" as="geometry"/></mxCell><mxCell id="p11-I" value="Pegawai yang tidak ada di API jadi tidak aktif, tidak dihapus" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="1076" width="250" height="68" as="geometry"/></mxCell><mxCell id="p11-J" value="Departemen dari nilai unik departemen kecuali tanda hubung: buat yang baru, aktifkan kembali, nonaktifkan yang hilang kecuali SHD; nama lengkap lokal tidak ditimpa" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="1214" width="250" height="119" as="geometry"/></mxCell><mxCell id="p11-K" value="Catat run berhasil + jumlah; kosongkan cache master" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="1403" width="250" height="68" as="geometry"/></mxCell><mxCell id="p11-V" value="